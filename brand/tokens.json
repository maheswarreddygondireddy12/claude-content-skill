{
  "_about": "Generic editable visual tokens. Adapt palette, type, motion, safe areas, and audio targets to each project.",
  "canvas": { "width": 1080, "height": 1920, "fps": 30 },
  "color": {
    "core": {
      "ink": "#05070C",
      "night": "#0A1020",
      "navy": "#0E1A33",
      "steel": "#1B2B4A",
      "glow": "#4FB3FF",
      "glowSoft": "#8CCBFF",
      "white": "#F5F8FF",
      "muted": "#8A97AE",
      "line": "#24324F"
    },
