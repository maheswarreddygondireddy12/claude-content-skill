    "springs": {
      "snappy": { "damping": 18, "stiffness": 220, "mass": 0.6 },
      "smooth": { "damping": 26, "stiffness": 120, "mass": 1 },
      "bouncy": { "damping": 10, "stiffness": 180, "mass": 0.7 },
      "heavy": { "damping": 30, "stiffness": 90, "mass": 1.4 }
    },
    "durations": { "micro": 6, "short": 10, "medium": 18, "long": 30 },
    "personalities": {
      "crisp": { "spring": "snappy", "enter": "rise", "stagger": 2 },
      "calm": { "spring": "smooth", "enter": "fade", "stagger": 4 },
      "playful": { "spring": "bouncy", "enter": "pop", "stagger": 3 },
      "cinematic": { "spring": "heavy", "enter": "blurIn", "stagger": 5 }
    }
  },
  "audio": {
    "voLufsTarget": -14,
    "sfxGainDb": { "subtle": -22, "normal": -16, "accent": -11 },
    "musicDuckDb": -18
