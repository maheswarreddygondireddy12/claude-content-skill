    "bottomUi": 380,
    "rightRail": 160,
    "side": 64,
    "content": { "x": 64, "y": 220, "width": 856, "height": 1320 }
  },
  "radius": { "sm": 12, "md": 24, "lg": 40, "pill": 999 },
